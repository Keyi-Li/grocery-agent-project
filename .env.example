# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- OpenRouter (LLM parsing, Stage 5) ---
# openrouter.ai/keys. This is a simple structured-extraction task, so
# a cheap model is plenty — override OPENROUTER_MODEL if you'd rather
# use something other than the default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash

# --- Supabase ---
# Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> Database -> Connect -> pooler connection strings
# (the direct db.<ref>.supabase.co host is IPv6-only and unreachable
# from most networks, so we use the poolers instead)
# Transaction-mode pooler (IPv4): used by the app at runtime
DATABASE_URL=
# Session-mode pooler: used for migrations (needs session-level
# features transaction pooling doesn't support)
DIRECT_URL=

# --- Telegram (push notifications) ---
# Create a bot via @BotFather on Telegram to get this token (one bot,
# shared across all households). Each household's group chat id is
# stored on its Household row in the DB, not here — see Section 3c of
# docs/grocery-agent-plan.md.
TELEGRAM_BOT_TOKEN=
# Verifies incoming webhook calls really come from Telegram. Generate
# your own, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# --- Siri Shortcut auth (Stage 7) ---
# A plain Shortcut can't run a Supabase login/refresh flow on its own,
# so it authenticates with this fixed secret instead. Generate your
# own, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SIRI_SHORTCUT_TOKEN=
# Filled in after you run scripts/setup_household.py (prints the id).
SIRI_DEFAULT_USER_ID=
