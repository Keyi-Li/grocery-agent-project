# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- LLM (any OpenAI-compatible endpoint: OpenRouter, a self-hosted
# proxy, etc.) --- all three required, no fallback if left blank.
# openrouter.ai/keys is the simplest starting point.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.7-flash
# Vision model for receipt-photo parsing — needs image input support.
VISION_MODEL=google/gemini-2.5-flash

# --- Supabase --- used purely as a hosted Postgres provider (no
# Supabase Auth calls anywhere — identity comes from Telegram).
# Project Settings -> Database -> Connect -> pooler connection strings
# (the direct db.<ref>.supabase.co host is IPv6-only and unreachable
# from most networks, so we use the poolers instead)
# Transaction-mode pooler (IPv4): used by the app at runtime
DATABASE_URL=
# Session-mode pooler: used for migrations (needs session-level
# features transaction pooling doesn't support)
DIRECT_URL=

# --- Telegram (push notifications) ---
# Create a bot via @BotFather on Telegram to get this token (one bot,
# shared across all households). Each household's group chat id is
# stored on its Household row in the DB, not here.
TELEGRAM_BOT_TOKEN=
# Verifies incoming webhook calls really come from Telegram. Generate
# your own, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# --- Generic API auth (for testing/scripting against /utterance) ---
# Only needed if you want to use /utterance directly — real households
# don't need this, they're created by messaging the bot on Telegram.
# Generate your own, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Any existing household id (see households table, or run
# scripts/setup_household.py to create one).
API_DEFAULT_HOUSEHOLD_ID=

# --- Scheduled reminder check (POST /internal/check_reminders) ---
# Protects the endpoint an external scheduler (see .github/workflows)
# calls periodically to check every household for due reminders —
# decoupled from user requests entirely. Generate your own, e.g.:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# --- Modal (sandboxed code-execution tool) ---
# modal.com -> Settings -> API Tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# The deployed app's own public URL — the Modal sandbox calls back into
# /internal/sandbox/* on this host (it has no DB credentials itself).
APP_BASE_URL=
